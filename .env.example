# WPM (Wealth Portfolio Manager) Configuration
# Copy this file to .env and fill in your actual values
# The .env file is gitignored and will not be committed to version control

# CoinGecko API Key (optional)
# CoinGecko free tier works without an API key, but using a key provides higher rate limits
# Get your API key from: https://www.coingecko.com/en/api
# COINGECKO_API_KEY=your_coingecko_api_key_here
